# Скопируйте в .env и заполните. Файл .env НЕ должен попадать в git или архивы.

PORT=3000
# Публичный адрес сайта (для ссылок в письмах, OAuth, sitemap, Open Graph)
BASE_URL=http://localhost:3000
# Если сайт стоит за nginx / Cloudflare / хостингом с прокси — поставьте 1
TRUST_PROXY=0

# Секрет сессий. Если пусто — сгенерируется и сохранится в data/.session_secret
SESSION_SECRET=

# Администратор. Создаётся при первом запуске, если админа ещё нет.
# Если ADMIN_PASSWORD пусто — пароль будет сгенерирован и показан в консоли ОДИН раз.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SITE_NAME=XMinusYC

# Почта (подтверждение email, сброс пароля, уведомления о жалобах).
# Для Gmail нужен «пароль приложения». Без SMTP сайт работает, а ссылки пишутся в консоль.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Куда присылать жалобы и заявления правообладателей
REPORT_EMAIL=

# Требовать подтверждённый email для загрузки треков
REQUIRE_VERIFIED_EMAIL=false

# OAuth (необязательно). Redirect URI: {BASE_URL}/api/auth/google/callback и /api/auth/yandex/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# OAUTH_BASE_URL=   # только если отличается от BASE_URL

# Сколько ежедневных копий БД хранить (data/backups)
BACKUP_KEEP=7
